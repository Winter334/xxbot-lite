DISCORD_TOKEN=replace-me
APPLICATION_ID=
DATABASE_URL=sqlite+aiosqlite:///./data/xxbot.sqlite3
BROADCAST_CHANNEL_ID=
LOG_LEVEL=INFO
# 可选：realm_key -> Discord 身份组 ID，填写为单行 JSON，无需给整段 JSON 再加引号。
# 未配置的境界按身份组中文名称精确匹配；名称有装饰字符时，可通过 ID 指定。
# 当前 Bot 大境界表（只按大境界，不区分前期、中期、后期、圆满）：
# realm_key | 境界
# lianqi    | 炼气
# zhuji     | 筑基
# jiedan    | 结丹
# yuanying  | 元婴
# huashen   | 化神
# lianxu    | 炼虚
# heti      | 合体
# dacheng   | 大乘
# dujie     | 渡劫
# weixian   | 伪仙（本服无对应身份组，省略此项）
# 省略 weixian 不会自动代领其他境界；无同名身份组时，伪仙角色会收到缺少身份组的提示。
# 仙道境界尚未在 Bot 开放，暂不配置。不要用 0、空字符串或 null 表示无身份组。
# 以下 ID 均为虚构示例，请替换为当前服务器已有身份组的真实 ID，修改后重启 Bot：
# REALM_ROLE_IDS={"lianqi":"10001","zhuji":"10002","jiedan":"10003","yuanying":"10004","huashen":"10005","lianxu":"10006","heti":"10007","dacheng":"10008","dujie":"10009"}
REALM_ROLE_IDS=
